# Keep the Docker build context small and secret-free.
# Images install their own dependencies from package-lock.json.
**/node_modules
**/dist
**/*.tsbuildinfo

# Never bake local secrets into an image
.env
.env.*
!.env.example

.git
.github
.claude
.vscode
.idea
docs
**/*.log
**/*.md
!apps/**/README.md
