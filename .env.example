# ─────────────────────────────────────────────────────────────
# pgPulse environment variables
# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. These defaults are for the LOCAL DEMO only.
# ─────────────────────────────────────────────────────────────

# ── Postgres container (superuser, used only by init.sql + loadgen) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
# Host port for the container. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

# ── Read-only monitoring user (created by init.sql, has pg_monitor role) ──
READER_USER=pgpulse_reader
READER_PASSWORD=reader_dev_password

# ── Database URLs used by the server ──
# LOCAL DEV: server runs on your machine (npm run dev:server),
# Postgres runs in Docker and is reachable on localhost:5433.
# Monitored database — read-only user, never written to:
TARGET_DATABASE_URL=postgres://pgpulse_reader:reader_dev_password@localhost:5433/demo_shop
# pgPulse's own database — stores metric_samples history:
APP_DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5433/pgpulse

# INSIDE DOCKER COMPOSE the two URLs above are NOT used. docker-compose.yml
# builds them for the server container from POSTGRES_USER/PASSWORD and
# READER_USER/PASSWORD, with host "postgres" (the compose service name) and
# port 5432 (the container's internal port), e.g.
#   postgres://pgpulse_reader:reader_dev_password@postgres:5432/demo_shop
# so each password lives in exactly one place.

# ── Server ──
# Port of the API: `npm run dev:server` listens on it, and in Docker it's the host port.
SERVER_PORT=4000
# Browser origin allowed by CORS / Socket.IO (local dev; compose derives it from WEB_PORT)
CORS_ORIGIN=http://localhost:5173
# How often the live collector reads stats (ms)
COLLECT_INTERVAL_MS=2000
# How often a snapshot is saved to metric_samples (ms)
SAMPLE_INTERVAL_MS=60000
# Kill any monitoring query that runs longer than this (ms)
TARGET_STATEMENT_TIMEOUT_MS=5000

# ── Web ──
# Port of the UI: `npm run dev:web` (Vite) listens on it, and in Docker it's the host port.
WEB_PORT=5173
# Where the BROWSER finds the API. Local dev reads it from here; the Docker
# image bakes in http://localhost:${SERVER_PORT} at build time instead.
# (Vite only exposes VITE_* variables to browser code.)
VITE_API_URL=http://localhost:4000
